# Meridian Tax & Advisory Intake Configuration Template
# Copy this file to .env and add your Gemini API Key

# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL with pgvector or SQLite)
DATABASE_URL=postgresql+psycopg2://localhost:5432/meridian_intake
# SQLite fallback: sqlite:///./intake_database.db
